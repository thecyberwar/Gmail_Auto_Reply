# =============================================================================
# CONFIGURATION — copy this file to  .env  and fill in your own values.
# .env is git-ignored: NEVER commit real credentials.
# =============================================================================

# --- Gmail credentials (required) -------------------------------------------
# Gmail address the bot monitors and sends from.
GMAIL_USER=your@gmail.com
# 16-character Google App Password (Google Account -> Security -> App passwords).
# Spaces are allowed, they get stripped automatically.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Auto-reply content ------------------------------------------------------
# Sender name shown in the reply ("From" display name + template header).
APP_NAME=Auto Reply Bot
# HTML template to use — file name inside templates/ (without .html).
AUTO_REPLY_TEMPLATE=premiumReply
# Subject prefix used for the reply.
AUTO_REPLY_SUBJECT=Auto Reply
# Reply body. QUOTES ARE REQUIRED for multi-line values (dotenv parses them).
AUTO_REPLY_MESSAGE="Hi,

Thanks for your email! I have received your message and will get back to you soon.

Regards"

# --- API server --------------------------------------------------------------
# Port the HTTP API listens on.
PORT=3000
# Random secret required in the  x-api-key  header for all /api/* calls.
API_KEY=change_this_random_key
# true = start the polling loop automatically on boot.
# false = start it later via POST /api/automation/start
AUTO_START=true
# true = print debug-level logs.
DEBUG=false

# --- Automation settings -----------------------------------------------------
# How often (in seconds) the inbox is checked for new messages.
POLL_INTERVAL_SECONDS=45
# true  = ignore all pre-existing mails on the first run (only NEW mails get a reply).
# false = reply to every message currently in the inbox as well.
START_FROM_NOW=true
# Optional allowlist of sender addresses, comma separated.
# Leave empty to reply to everyone.
REPLY_TO_SENDERS=
# Maximum number of replies sent per poll cycle (safety cap).
MAX_REPLIES_PER_POLL=10
# true = log what would be sent WITHOUT actually sending (safe testing mode).
DRY_RUN=false
